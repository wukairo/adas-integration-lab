[Unit]
Description=ADAS lab Jenkins validation controller
After=network-online.target adas-vcan.service
Wants=network-online.target
Requires=adas-vcan.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PROJECT@
ExecStart=@PROJECT@/scripts/start_jenkins_lab.sh
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
